# SONS of BANE Audit Tool — local config
# ========================================
# Copy this file to "Auth.env" and fill in the values. Do NOT commit Auth.env.
# In production (Railway) set these as environment variables instead.

# ── EVE SSO ──────────────────────────────────────────────────────────────────
# Register an app at https://developers.eveonline.com/ with scope
# esi-characters.read_corporation_roles.v1 and the callback URL below.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=http://localhost:8000/auth/callback

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me

# ── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated EVE character IDs granted admin (alliance audit, cache, creds).
ADMIN_CHARS=

# ── Alliance Auth scraper cookie ─────────────────────────────────────────────
# Log in to https://auth.sonsofbane.com in Chrome, open DevTools (F12) →
# Application → Cookies → auth.sonsofbane.com, and copy the sessionid + csrftoken
# values. Typically lasts ~2 weeks; re-copy on auth errors. Admins can also save
# this from the web UI instead of here.
SESSION_COOKIE="sessionid=PASTE_SESSION_ID; csrftoken=PASTE_CSRF_TOKEN"
